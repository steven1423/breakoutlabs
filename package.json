{
  "name": "breakoutos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "node --env-file-if-exists=.env.local scripts/migrate.mts",
    "gen:types": "pnpm dlx supabase@2.117.0 gen types typescript --project-id \"$SUPABASE_PROJECT_REF\" --schema public > lib/db/types.ts",
    "seed": "node --env-file-if-exists=.env.local supabase/seed.mts",
    "sweep": "node --env-file-if-exists=.env.local scripts/sweep.mts",
    "eval": "node --env-file-if-exists=.env.local scripts/eval.mts",
    "discover": "node --env-file-if-exists=.env.local scripts/discover.mts",
    "models": "node --env-file-if-exists=.env.local scripts/models.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.126.0",
    "@google/genai": "2.22.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "lucide-react": "1.46.0",
    "next": "16.3.5",
    "onnxruntime-web": "1.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "seedrandom": "3.0.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/seedrandom": "3.0.8",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
